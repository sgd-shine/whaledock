{
  "name": "whaledock",
  "productName": "WhaleDock",
  "version": "0.9.0",
  "description": "鲸坞 WhaleDock — Unofficial desktop app for DeepSeek Harness (dsh): auto-starts the local dsh backend and wraps its Web UI in a native window. 非官方 DeepSeek Harness 桌面客户端：给鲸鱼一个靠岸的坞。",
  "main": "main.js",
  "author": "SGD",
  "license": "MIT",
  "homepage": "https://github.com/sgd-shine/whaledock",
  "scripts": {
    "start": "electron .",
    "smoke": "node test/smoke.js",
    "sign:mac": "node scripts/macos-codesign.js sign",
    "verify:mac": "node scripts/macos-codesign.js verify-dir",
    "bundle:dsh": "node scripts/bundle-dsh.js",
    "compliance:sources": "node scripts/third-party-inventory.js sources --inventories=compliance --sources=compliance/SOURCES.json --output=compliance/SOURCES.md",
    "compliance:notices": "node scripts/third-party-inventory.js notices --inventories=compliance --output=THIRD_PARTY_NOTICES.md",
    "compliance:verify": "node scripts/third-party-inventory.js sources --check --inventories=compliance --sources=compliance/SOURCES.json --output=compliance/SOURCES.md && node scripts/third-party-inventory.js notices --check --inventories=compliance --sources=compliance/SOURCES.json --output=THIRD_PARTY_NOTICES.md",
    "app-runtime:generate": "node scripts/app-runtime-compliance.js generate",
    "app-runtime:verify": "node scripts/app-runtime-compliance.js verify",
    "dist": "npm run dist:mac:arm64",
    "dist:mac": "npm run dist:mac:arm64 && npm run dist:mac:x64",
    "predist:mac:arm64": "npm run bundle:dsh -- --platform=darwin --arch=arm64",
    "dist:mac:arm64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64 --publish never",
    "predist:mac:x64": "npm run bundle:dsh -- --platform=darwin --arch=x64",
    "dist:mac:x64": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --x64 --publish never",
    "predist:win": "npm run bundle:dsh -- --platform=win32 --arch=x64",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sgd.whaledock",
    "productName": "WhaleDock",
    "beforePack": "scripts/macos-build-visibility.js",
    "afterPack": "scripts/macos-codesign.js",
    "afterAllArtifactBuild": "scripts/macos-build-visibility.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-settings.js",
      "preload-dashboard.js",
      "preload-notice.js",
      "preload-report.js",
      "preload-capture.js",
      "preload-pet.js",
      "preload-shell.js",
      "preload-shooting.js",
      "splash.html",
      "settings.html",
      "dashboard.html",
      "dashboard.js",
      "notice.html",
      "notice.js",
      "report-card.html",
      "report-card.js",
      "capture.html",
      "capture.js",
      "pet.html",
      "pet.js",
      "shell.html",
      "shell.js",
      "shooting.html",
      "shooting.css",
      "shooting.js",
      "LICENSE",
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/ocr",
        "to": "ocr",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/dsh-runtime",
        "to": "dsh-runtime",
        "filter": [
          "package.json",
          "package-lock.json",
          "manifest.json"
        ]
      },
      {
        "from": "vendor/dsh-runtime/node_modules",
        "to": "dsh-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "compliance/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "compliance/SOURCES.md",
        "to": "compliance/SOURCES.md"
      },
      {
        "from": "compliance/SOURCES.json",
        "to": "compliance/SOURCES.json"
      },
      {
        "from": "licenses",
        "to": "compliance/licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "compliance/app-runtime",
        "to": "compliance/app-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "gatekeeperAssess": false,
      "icon": "build/icon.png",
      "artifactName": "WhaleDock-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "WhaleDock-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "WhaleDock-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "WhaleDock-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0"
  }
}
