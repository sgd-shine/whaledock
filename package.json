{
  "name": "whaledock",
  "productName": "WhaleDock",
  "version": "0.1.1",
  "description": "鲸坞 WhaleDock — Unofficial desktop app for DeepSeek Harness (dsh): auto-starts the local dsh backend and wraps its Web UI in a native window. 非官方 DeepSeek Harness 桌面客户端：给鲸鱼一个靠岸的坞。",
  "main": "main.js",
  "author": "SGD",
  "license": "MIT",
  "homepage": "https://github.com/sgd-shine/whaledock",
  "scripts": {
    "start": "electron .",
    "smoke": "node test/smoke.js",
    "bundle:dsh": "node scripts/bundle-dsh.js",
    "predist": "npm run bundle:dsh",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sgd.whaledock",
    "productName": "WhaleDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/dsh-runtime",
        "to": "dsh-runtime",
        "filter": ["package.json", "package-lock.json", "manifest.json"]
      },
      {
        "from": "vendor/dsh-runtime/node_modules",
        "to": "dsh-runtime/node_modules",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ]
    }
  }
}
